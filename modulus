"""
Module: Text Processing (NLP)
Sanitizes input, tokenizes words, and extracts links, phones, and urgency triggers.
"""

import re
from typing import Dict, List, Any


class NLPProcessor:
    def __init__(self):
        self.suspicious_domains = [
            r'bit\.ly', r'tinyurl\.com', r't\.co', r'is\.gd', r'cutt\.ly',
            r'rb\.gy', r'shorturl\.at', r'wa\.me', r'ngrok\.io'
        ]
        
        self.urgency_keywords = [
            'urgent', 'immediately', 'within 24 hours', 'expires today',
            'account suspended', 'account blocked', 'deactivated', 'kyc update',
            'claim now', 'congratulations', 'won prize', 'lottery winner', 'free gift',
            'share otp', 'enter pin', 'touch the link', 'take the money'
        ]

    def extract_urls(self, text: str) -> List[str]:
        url_pattern = r'https?://[^\s<>"]+|www\.[^\s<>"]+'
        return re.findall(url_pattern, text, re.IGNORECASE)

    def extract_phone_numbers(self, text: str) -> List[str]:
        phone_pattern = r'(?:\+?\d{1,3}[-.\s]?)?\(?\d{3,5}\)?[-.\s]?\d{3,5}[-.\s]?\d{3,5}'
        matches = re.findall(phone_pattern, text)
        return [m.strip() for m in matches if sum(c.isdigit() for c in m) >= 7]

    def extract_monetary_values(self, text: str) -> List[str]:
        money_pattern = r'(?:[₹$€£]|Rs\.?|INR|USD)\s*[\d,]+(?:\.\d+)?|\b\d+\s*(?:lakh|crore|thousand|k)\b|\b50000\b'
        return re.findall(money_pattern, text, re.IGNORECASE)

    def clean_text(self, text: str) -> str:
        if not text:
            return ""
        cleaned = re.sub(r'[\u200B-\u200D\uFEFF]', '', text)
        cleaned = re.sub(r'\s+', ' ', cleaned).strip()
        return cleaned

    def process(self, raw_message: str) -> Dict[str, Any]:
        cleaned_text = self.clean_text(raw_message)
        tokens = re.findall(r'\b\w+\b', cleaned_text.lower())
        urls = self.extract_urls(raw_message)
        phones = self.extract_phone_numbers(raw_message)
        monetary_mentions = self.extract_monetary_values(raw_message)

        lower_msg = raw_message.lower()
        detected_urgency = [kw for kw in self.urgency_keywords if kw in lower_msg]

        has_suspicious_domain = any(
            re.search(pat, url, re.IGNORECASE) for pat in self.suspicious_domains for url in urls
        )

        return {
            "original_text": raw_message,
            "cleaned_text": cleaned_text,
            "tokens_count": len(tokens),
            "extracted_urls": urls,
            "extracted_phones": phones,
            "extracted_monetary_mentions": monetary_mentions,
            "detected_urgency_triggers": detected_urgency,
            "has_suspicious_link_shortener": has_suspicious_domain
        }